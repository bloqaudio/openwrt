 		err = dsa_user_add_cls_matchall_police(dev, cls, ingress);
+	else if (flow_offload_has_one_action(&cls->rule->action) &&
+		 cls->rule->action.entries[0].id == FLOW_ACTION_SAMPLE)
+		err = dsa_user_add_cls_matchall_sample(dev, cls, ingress);
 
 	return err;
 }
