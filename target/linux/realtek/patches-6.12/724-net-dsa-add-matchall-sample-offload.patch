+static int
+dsa_user_add_cls_matchall_sample(struct net_device *dev,
+				 struct tc_cls_matchall_offload *cls,
+				 bool ingress)
+{
+	struct netlink_ext_ack *extack = cls->common.extack;
+	struct dsa_port *dp = dsa_user_to_port(dev);
+	struct dsa_user_priv *p = netdev_priv(dev);
+	struct dsa_mall_sample_tc_entry *sample;
+	struct dsa_mall_tc_entry *mall_tc_entry, *tmp;
+	struct dsa_switch *ds = dp->ds;
+	struct flow_action_entry *act;
+	int err;
+
+	if (!ds->ops->port_sample_add) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "Sampling offload not implemented");
+		return -EOPNOTSUPP;
+	}
+
+	if (!flow_action_basic_hw_stats_check(&cls->rule->action,
+					      cls->common.extack))
+		return -EOPNOTSUPP;
+
+	act = &cls->rule->action.entries[0];
+
+	if (!act->sample.psample_group)
+		return -EINVAL;
+
+	/* Typical switch ASICs provide a single sampler per port and
+	 * direction, so replacing a filter replaces the programmed
+	 * sampler in place instead of failing with -EEXIST.
+	 */
+	list_for_each_entry_safe(mall_tc_entry, tmp, &p->mall_tc_list, list) {
+		if (mall_tc_entry->type == DSA_PORT_MALL_SAMPLE &&
+		    mall_tc_entry->sample.ingress == ingress) {
+			if (ds->ops->port_sample_del)
+				ds->ops->port_sample_del(ds, dp->index,
+							 &mall_tc_entry->sample);
+			list_del(&mall_tc_entry->list);
+			kfree(mall_tc_entry);
+		}
+	}
+
+	mall_tc_entry = kzalloc(sizeof(*mall_tc_entry), GFP_KERNEL);
+	if (!mall_tc_entry)
+		return -ENOMEM;
+
+	mall_tc_entry->cookie = cls->cookie;
+	mall_tc_entry->type = DSA_PORT_MALL_SAMPLE;
+	sample = &mall_tc_entry->sample;
+	sample->ingress = ingress;
+	sample->rate = act->sample.rate;
+	sample->trunc_size = act->sample.trunc_size;
+	sample->truncate = act->sample.truncate;
+	sample->psample_group = act->sample.psample_group;
+
+	err = ds->ops->port_sample_add(ds, dp->index, sample, extack);
+	if (err) {
+		kfree(mall_tc_entry);
+		return err;
+	}
+
+	list_add_tail(&mall_tc_entry->list, &p->mall_tc_list);
+
+	return 0;
+}
