#!/bin/sh /etc/rc.common
# Copyright (c) 2021 OpenWrt.org

# Must precede netifd: the kernel runs bridge-stp synchronously while netifd
# creates an STP bridge, and that helper needs ustpd on ubus to hand the bridge
# to userspace. Losing that race costs a full 802.1D convergence.
START=19

USE_PROCD=1
PROG=/sbin/ustpd

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn
	procd_close_instance
}
